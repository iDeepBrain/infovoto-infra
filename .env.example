# ── InfoVoto Local Development ──────────────────────────────────────────────
# Copiar a .env y completar con valores reales. NUNCA commitear .env.

# App
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database (Supabase en prod, local Postgres en dev)
DATABASE_URL=postgresql+asyncpg://infovoto:localdev@postgres:5432/infovoto

# Redis (Upstash en prod, local Redis en dev)
REDIS_URL=redis://redis:6379/0

# Google AI
GOOGLE_API_KEY=your-google-ai-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth
GOOGLE_CLIENT_ID=your-project.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# MCP Servers (comma-separated URLs, internal Docker network)
MCP_URLS=http://mcp-perfiles:8001

# NextAuth (web frontend)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:2300

# WhatsApp Business API (Meta) — solo para canal WhatsApp
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret-for-hmac
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Admin
ADMIN_TOKEN=your-admin-token-for-kill-switch

# Scraper / Azure OCR
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://mi-recurso.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key

# Scraper / ChromaDB (vector store local para planes de gobierno)
CHROMA_PERSIST_DIR=./data/chroma
